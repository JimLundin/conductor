language js(typescript)

or {
    TsPropertySignatureTypeMember(),
    JsPropertyClassMember()
} as $member where {
    not $member <: r"(?s)(?:[a-z]+\s+)*readonly\s.*",
    register_diagnostic(
        span = $member,
        message = "Mutable property: mark it readonly and return a new value instead."
    )
}
