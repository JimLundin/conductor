{
  "name": "conductor-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run pipe && vite",
    "pipe": "wasm-pack build ../crates/web-iroh --target web --profile wasm --out-dir ../../web/web-iroh --no-pack",
    "build": "npm run pipe && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:full": "vitest run --mode full",
    "check": "tsc && oxlint && oxfmt --check"
  },
  "dependencies": {
    "effect": "4.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fast-check": "4.11.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26"
  }
}
