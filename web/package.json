{
  "name": "conductor-web",
  "private": true,
  "workspaces": [
    "core",
    "scripts"
  ],
  "type": "module",
  "imports": {
    "#ui/*": "./src/*",
    "#transport": "./web-iroh/web_iroh.js"
  },
  "scripts": {
    "dev": "npm run pipe && vite",
    "pipe": "wasm-pack build ../crates/web-iroh --target web --profile wasm --out-dir ../../web/web-iroh --no-pack",
    "build": "npm run pipe && vite build",
    "preview": "vite preview",
    "check": "tsc"
  },
  "dependencies": {
    "@conductor/core": "*",
    "@effect/atom-react": "4.1.5",
    "@effect/platform-browser": "4.1.5",
    "effect": "4.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "knip": "6.48.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "standards": {
    "layer": "ui"
  }
}
