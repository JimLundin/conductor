#!/usr/bin/env bash
# Runs the subset checker (https://github.com/JimLundin/subset) at the
# revision Conductor pins, building it into this checkout's target dir once.
# Usage: tools/subset check | score [paths...] | measure <paths...> | ...
set -euo pipefail
cd "$(dirname "$0")/.."
REPO=https://github.com/JimLundin/subset
REV=b02997b97b1db70bdc12ad903ca433ca5dc094cc
root="$(tools/target-dir)/subset-$REV"
if [ ! -x "$root/bin/subset" ]; then
  cargo install --quiet --locked --git "$REPO" --rev "$REV" --root "$root" subset
fi
exec "$root/bin/subset" "$@"
